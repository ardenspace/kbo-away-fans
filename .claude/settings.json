            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/check-hardcoded-values.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/check-hardcoded-values.sh\"; fi"
          }
        ]
      }
    ]
  }
}
